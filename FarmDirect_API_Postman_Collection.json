{
  "info": {
    "_postman_id": "farmdirect-api-collection",
    "name": "FarmDirect API Collection",
    "description": "Complete collection of API endpoints for FarmDirect with realistic dummy data for testing catalog, cart, checkout, payments, and UN SDG analytics.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "consumerId",
      "value": "3",
      "type": "string"
    },
    {
      "key": "farmerId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Products API",
      "item": [
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            },
            "description": "Browse active farm produce catalog with live dynamic pricing and freshness indicators."
          }
        },
        {
          "name": "Get Product By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "{{productId}}"]
            },
            "description": "Returns detailed specifications, origin farm, and shelf-life."
          }
        },
        {
          "name": "Get Products By Category",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/category/VEGETABLES",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "category", "VEGETABLES"]
            },
            "description": "Filter by category: VEGETABLES, FRUITS, GRAINS_PULSES, DAIRY, HERBS_SPICES, ORGANIC_HONEY, PROCESSED_GOODS"
          }
        },
        {
          "name": "Get Perishable Clearance Deals (SDG 12.3)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/clearance",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "clearance"]
            },
            "description": "Returns perishable items nearing their shelf-life with an automatic 25% waste-reduction discount."
          }
        },
        {
          "name": "Add Produce (Perishable)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"produceType\": \"PERISHABLE\",\n  \"name\": \"Fresh Organic Strawberries\",\n  \"description\": \"Hand-picked sweet mountain strawberries from Mahabaleshwar.\",\n  \"category\": \"FRUITS\",\n  \"unit\": \"box (250g)\",\n  \"basePrice\": 120.00,\n  \"stockQuantity\": 40,\n  \"farmerId\": 1,\n  \"harvestDate\": \"2026-10-20\",\n  \"shelfLifeDays\": 4,\n  \"coldStorageRequired\": true,\n  \"freshnessGrade\": \"Grade A+ Premium\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            },
            "description": "Direct producer listing for fresh perishable produce."
          }
        },
        {
          "name": "Add Produce (Processed / Artisanal)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"produceType\": \"PROCESSED\",\n  \"name\": \"Wood-Pressed Extra Virgin Coconut Oil\",\n  \"description\": \"Pure unrefined extra virgin coconut oil from coastal organic farms.\",\n  \"category\": \"PROCESSED_GOODS\",\n  \"unit\": \"500ml Bottle\",\n  \"basePrice\": 310.00,\n  \"stockQuantity\": 50,\n  \"farmerId\": 2,\n  \"processingMethod\": \"Cold Centrifuge Extraction\",\n  \"packagingDate\": \"2026-10-10\",\n  \"shelfLifeMonths\": 18,\n  \"certificationStandard\": \"India Organic & Jaivik Bharat\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            },
            "description": "Listing for processed/value-added farm goods."
          }
        }
      ]
    },
    {
      "name": "2. Cart API",
      "item": [
        {
          "name": "Get User Cart",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cart/{{consumerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cart", "{{consumerId}}"]
            },
            "description": "Returns current shopping cart with item subtotals, total cart amount, direct farmer payout share (90%), and consumer savings."
          }
        },
        {
          "name": "Add Item to Cart",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 3,\n  \"productId\": 3,\n  \"quantity\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/cart",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cart"]
            },
            "description": "Adds produce to cart or increments quantity. Validates stock availability."
          }
        },
        {
          "name": "Update Cart Item Quantity",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/cart/{{consumerId}}/items/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cart", "{{consumerId}}", "items", "{{productId}}"]
            },
            "description": "Modifies quantity of an item in the cart. Setting quantity to 0 removes the item."
          }
        },
        {
          "name": "Remove Item from Cart",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cart/{{consumerId}}/items/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cart", "{{consumerId}}", "items", "{{productId}}"]
            },
            "description": "Deletes a specific product line item from the user's cart."
          }
        },
        {
          "name": "Clear Cart",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cart/{{consumerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cart", "{{consumerId}}"]
            },
            "description": "Empties all items from the user's active shopping cart."
          }
        }
      ]
    },
    {
      "name": "3. Orders & Checkout API",
      "item": [
        {
          "name": "Checkout Cart (UPI Payment)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 3,\n  \"deliveryAddress\": \"Flat 402, Green Meadows Apartment, Indiranagar, Bengaluru - 560038\",\n  \"payment\": {\n    \"paymentMethod\": \"UPI\",\n    \"upiId\": \"aarav.sharma@okaxis\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders/checkout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "checkout"]
            },
            "description": "Executes cart checkout with UPI payment."
          }
        },
        {
          "name": "Checkout Cart (Card Payment)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 3,\n  \"deliveryAddress\": \"Flat 402, Green Meadows Apartment, Indiranagar, Bengaluru - 560038\",\n  \"payment\": {\n    \"paymentMethod\": \"CREDIT_CARD\",\n    \"cardNumber\": \"4111222233334444\",\n    \"cardHolderName\": \"Aarav Sharma\",\n    \"expiryMonth\": 12,\n    \"expiryYear\": 2028,\n    \"cvv\": \"123\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders/checkout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "checkout"]
            },
            "description": "Executes cart checkout with Credit/Debit card payment."
          }
        },
        {
          "name": "Checkout Cart (Cash on Delivery)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 3,\n  \"deliveryAddress\": \"Flat 402, Green Meadows Apartment, Indiranagar, Bengaluru - 560038\",\n  \"payment\": {\n    \"paymentMethod\": \"CASH_ON_DELIVERY\",\n    \"notes\": \"Please bring exact change\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders/checkout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "checkout"]
            },
            "description": "Executes cart checkout with Cash on Delivery."
          }
        },
        {
          "name": "Get All Platform Orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            },
            "description": "Returns all orders placed across the FarmDirect network (Admin / Co-op view)."
          }
        },
        {
          "name": "Get User Orders History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders/user/4",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "user", "4"]
            },
            "description": "Returns all orders placed by consumer ID 4 (pre-seeded) or any user ID."
          }
        },
        {
          "name": "Get Order By Order Number",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders/ORD-EXAMPLE-ID",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "ORD-EXAMPLE-ID"]
            },
            "description": "Replace ORD-EXAMPLE-ID with an actual orderNumber from checkout response."
          }
        }
      ]
    },
    {
      "name": "4. UN SDG Impact & Analytics API",
      "item": [
        {
          "name": "Get SDG Impact Summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/impact/summary",
              "host": ["{{baseUrl}}"],
              "path": ["api", "impact", "summary"]
            },
            "description": "Returns metrics mapped to UN SDG 2 (Target 2.3) and SDG 12 (Target 12.3)."
          }
        }
      ]
    }
  ]
}