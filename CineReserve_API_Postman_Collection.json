							"raw": "{\n  \"showtimeId\": 1,\n  \"customerId\": 1,\n  \"showtimeSeatIds\": [11, 12],\n  \"payment\": {\n    \"paymentMethod\": \"CARD\",\n    \"cardNumber\": \"4532892311029942\",\n    \"cardHolderName\": \"Rahul Sharma\",\n    \"expiryMonth\": 12,\n    \"expiryYear\": 2028,\n    \"cvv\": \"842\"\n  }\n}"
						},
						"url": {
