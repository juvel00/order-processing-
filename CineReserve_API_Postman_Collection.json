							"raw": "{\n  \"showtimeId\": 1,\n  \"customerId\": 1,\n  \"showtimeSeatIds\": [3, 4],\n  \"payment\": {\n    \"paymentMethod\": \"UPI\",\n    \"upiId\": \"rahul.sharma@okaxis\"\n  }\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/bookings",
							"host": ["{{baseUrl}}"],
							"path": ["api", "bookings"]
						}
					}
				},
